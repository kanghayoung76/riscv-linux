#define _PAGE_VALID   _AC(0x1,UL)
#define gstage_pgd_size    (1UL << (HGATP_PAGE_SHIFT + 2))

struct hlv_min_fault {
    unsigned long scause;
    unsigned long stval;   /* 옵션: 필요없으면 빼도 됨 */
};

static __always_inline int hlv_d_scause(u64 *out, unsigned long gpa,
                                        struct hlv_min_fault *fi)
{
    u64 val;
    long err;

    if (fi) { fi->scause = 0; fi->stval = 0; }

    asm volatile(
        "0: .option push\n"
        "   .option norvc\n"
        "   hlv.d %0, (%3)\n"
        "   .option pop\n"
        "1:\n"
        "   li %1, 0\n"                /* err = 0 */
        "2:\n"

        /* 예외 발생 시: S-CSR만 읽고 복귀 */
        ".pushsection .fixup,\"ax\"\n"
        "3:\n"
        "   li %1, %4\n"               /* err = -EFAULT */
        "   beqz %5, 4f\n"
        "   csrr t0, scause\n"
        "   csrr t1, stval\n"          /* 선택: stval 보고 싶으면 유지 */
        "   sd t0, 0(%5)\n"
        "   sd t1, 8(%5)\n"
        "4:\n"
        "   j 2b\n"
        ".popsection\n"

        /* extable: HLV(D)에서 난 트랩만 fixup으로 이동 */
        ".pushsection __ex_table,\"a\"\n"
        "   .balign 8\n"
        "   .dword 0b, 3b\n"
        ".popsection\n"

        : "=&r"(val), "=&r"(err)
        : "0"(0), "r"(gpa), "i"(-EFAULT), "r"(fi)
        : "t0","t1","memory");

    if (!err) *out = val;
    return (int)err;
}


void __init genesis_test(void)
{
	void *p, *p2;
	int *p3, *shadow_p3;

	struct page *pgd_page = alloc_pages(__GFP_GENESIS | __GFP_ZERO, get_order(gstage_pgd_size));
	pgd_t *gpgd = page_address(pgd_page);
	unsigned long ppn = page_to_phys(pgd_page) >> PAGE_SHIFT;

	unsigned long hgatp = (HGATP_MODE_SV48X4 << HGATP_MODE_SHIFT)
                    | (ppn & GENMASK_ULL(43, 0));  // 44b 마스크
	csr_write(CSR_HGATP, hgatp);
	asm volatile("hfence.gvma x0, x0" ::: "memory");
	csr_write(CSR_VSATP, 0);
	asm volatile("hfence.vvma x0, x0" ::: "memory");


	pr_info("[GENESIS] TEST CODE START\n");
	pr_info("[GENESIS] TEST 1. GFP_GENESIS ");
	p = (void *)__get_free_page(GFP_KERNEL);
	pr_info("p1 va: 0x%px pa: 0x%lx (GFP_KERNEL)\n", p, __pa(p));
	p2 = (void *)__get_free_page(GFP_KERNEL);
	pr_info("p2 va: 0x%px pa: 0x%lx (GFP_KERNEL)\n", p2, __pa(p2));
	free_page((unsigned long int)p);
	free_page((unsigned long int)p2);

	p3 = (int *)__get_free_page(__GFP_GENESIS);
	pr_info("p3 va: 0x%px pa: 0x%lx (GFP_GENESIS)\n", p3, __pa(p3));

	pr_info("[GENESIS] TEST 2. SHADOW MAPPING ");
	pr_info("addr: %px, shadow_addr: %lx\n", p3, __virt_to_shadow(p3));
	*p3 = 1234; // okay
	shadow_p3 = (int *)__virt_to_shadow(p3);
	__enable_user_access();
	*shadow_p3 = 12345;
	pr_info("addr val: %d, shadow val: %d\n", *p3, *shadow_p3);
	__disable_user_access();
	free_page((unsigned long int)p3);

	pr_info("[GENESIS] TEST CODE END\n");

	pr_info("[DITO] GUEST ADDRESS SPACE TEST\n");
	/*
        p3 = (int *)__get_free_page(__GFP_DITO);
	pr_info("[DITO] p3 va: 0x%px pa: 0x%lx (GFP_DITO)\n", p3, __pa(p3));
	*/
        p3 = (int *)__get_free_page(GFP_KERNEL | GFP_DMA32 | __GFP_ZERO);
	pr_info("[DITO] p3 va: 0x%px pa: 0x%lx (GFP_DMA32)\n", p3, __pa(p3));

	unsigned long gpa = 0x400000UL;
	pgprot_t pprot = __pgprot(_PAGE_READ | _PAGE_WRITE | _PAGE_VALID | _PAGE_ACCESSED | _PAGE_DIRTY);
	unsigned bank = (gpa >> 52) & 3;
	pgd_t *gpgd_bank = (pgd_t *)((char *)gpgd + bank * PAGE_SIZE);
	create_pgd_mapping(gpgd_bank, gpa, __pa(p3), PAGE_SIZE, pprot);
	asm volatile("hfence.gvma x0, x0" ::: "memory");
        *p3 = 1234;
        u64 val = 0;
	/*
	asm volatile(HLV_D(%[val], %[addr])
        	    : [val] "=&r"(val)
        	    : [addr] "r"(gpa)
        	    : "memory");
		    */
	struct hlv_min_fault f;
	int rc = hlv_d_scause(&val, gpa, &f);   /* gpa는 예: 0x40000000UL */
	if (rc) {
	    pr_warn("HLV_D fault: rc=%d gpa=%#lx scause=%#lx stval=%#lx\n",
            		rc, gpa, f.scause, f.stval);
	} else {
		pr_info("[DITO] HLV_D OK: val=%#llx at gpa=%#lx\n", val, gpa);
	}
        pr_info("[DITO] kernel val: %ld, vm val: %ld, vm addr : 0x%lx\n", *p3, val, gpa);
        free_page((unsigned long int)p3);

	pr_info("[DITO] SATP : %lx\n",csr_read(CSR_SATP));
	pr_info("[DITO] HGATP : %lx\n",csr_read(CSR_HGATP));
	pr_info("[DITO] VSATP : %lx\n",csr_read(CSR_VSATP));
}

void __init genesis_zone_set_readonly(void)
{
	unsigned long base;
	int numpages;
	int ret;

	base = (unsigned long)__va(0x100000000);
	numpages = GENESIS_ZONE_SZ + DITO_ZONE_SZ;

#if (GENESIS_DEBUG)
	pr_info("[GENESIS] Mark GENESIS_ZONE as read-only "
		"0x%lx - 0x%lx\n", base, base + (numpages << PAGE_SHIFT));
#endif

	ret = set_memory_rw(base, numpages);
	if (ret)
		panic("[GENESIS] failed to mark readonly!");
}

void __init genesis_init(void)
{
	pr_info("[GENESIS] TEXT BEGIN: %px, END: %px\n", __genesis_text_begin,
					       __genesis_text_end);

#if (GENESIS_DEBUG)
	genesis_test();
#endif

#if (0) // Disable in QEMU
	set_kernel_memory(__privinst_begin, __privinst_end,
			  set_memory_u_x);
#endif

	genesis_enabled = 1;

	genesis_zone_set_readonly();
}
